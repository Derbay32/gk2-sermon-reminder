  "scenarios": [
    {
      "category": "localization",
      "evidence": {
        "log": false,
        "measurement": true,
        "screenshot": true
      },
      "expect": [
        {
          "equals": "zh_cn",
          "observation": "language.active"
        },
        {
          "localizedText": {
            "key": "gksr.settings.group.title",
            "language": "zh_cn"
          },
          "observation": "settings.groupTitleText"
        },
        {
          "localizedText": {
            "key": "gksr.settings.beacon.label",
            "language": "zh_cn"
          },
          "observation": "settings.beacon.labelText"
        },
        {
          "localizedText": {
            "key": "gksr.settings.beacon.description",
            "language": "zh_cn"
          },
          "observation": "settings.beacon.descriptionText"
        }
      ],
      "id": "beacon-settings-label-zh",
      "prerequisites": [
        "游戏语言为简体中文。",
        "完整加载模组并进入主菜单 Mods 中的本模组设置页面。"
      ],
      "profileId": "church-beacon",
      "requirements": [
        "GKSA-12"
      ],
      "steps": [
        "以简体中文进入本模组设置页面；预期语言为简体中文；检查 language.active=zh_cn。",
        "记录受检文本对应的实际资源查找；预期命中该场景指定的键与语言；检查 i18n.<文本观察路径>.key、language 与成功读取的 resource。",
        "读取受检文本；预期本地化输出有效；检查非空且没有资源键或未替换的占位符，不比较完整译文。"
      ],
      "title": "简体中文语言下显示本地化信标设置名称与说明"
    },
