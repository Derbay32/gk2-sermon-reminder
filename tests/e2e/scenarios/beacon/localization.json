{
  "kind": "gksr-e2e-scenarios",
  "scenarios": [
    {
      "category": "localization",
      "evidence": {
        "log": false,
        "measurement": true,
        "screenshot": true
      },
      "expect": [
        {
          "equals": "zh_cn",
          "observation": "language.active"
        },
        {
          "finalTextKey": "gksr.settings.group.title",
          "language": "zh-CN",
          "observation": "settings.groupTitleText"
        },
        {
          "finalTextKey": "gksr.settings.beacon.label",
          "language": "zh-CN",
          "observation": "settings.beacon.labelText"
        },
        {
          "finalTextKey": "gksr.settings.beacon.description",
          "language": "zh-CN",
          "observation": "settings.beacon.descriptionText"
        }
      ],
      "id": "beacon-settings-label-zh",
      "prerequisites": [
        "游戏语言为简体中文。",
        "完整加载模组并进入主菜单 Mods 中的本模组设置页面。"
      ],
      "profileId": "church-beacon",
      "requirements": [
        "GKSA-12"
      ],
      "steps": [
        "以简体中文进入本模组设置页面；预期语言为简体中文；检查 language.active=zh_cn。",
        "记录页面标题、信标开关名称与说明；预期均为已定稿简体中文文案；检查三者分别匹配 gksr.settings.group.title、gksr.settings.beacon.label、gksr.settings.beacon.description 且 language=zh-CN。"
      ],
      "title": "简体中文语言下显示已定稿的信标设置名称与说明"
    },
    {
      "category": "localization",
      "evidence": {
        "log": false,
        "measurement": true,
        "screenshot": true
      },
      "expect": [
        {
          "equals": "en",
          "observation": "language.active"
        },
        {
          "finalTextKey": "gksr.settings.group.title",
          "language": "en",
          "observation": "settings.groupTitleText"
        },
        {
          "finalTextKey": "gksr.settings.beacon.label",
          "language": "en",
          "observation": "settings.beacon.labelText"
        },
        {
          "finalTextKey": "gksr.settings.beacon.description",
          "language": "en",
          "observation": "settings.beacon.descriptionText"
        }
      ],
      "id": "beacon-settings-label-en",
      "prerequisites": [
        "游戏语言为英语。",
        "完整加载模组并进入主菜单 Mods 中的本模组设置页面。"
      ],
      "profileId": "church-beacon",
      "requirements": [
        "GKSA-12"
      ],
      "steps": [
        "以英语进入本模组设置页面；预期语言为英语；检查 language.active=en。",
        "记录页面标题、信标开关名称与说明；预期均为已定稿英语文案；检查三者分别匹配 gksr.settings.group.title、gksr.settings.beacon.label、gksr.settings.beacon.description 且 language=en。"
      ],
      "title": "英语语言下显示已定稿的信标设置名称与说明"
    },
    {
      "category": "localization",
      "evidence": {
        "log": false,
        "measurement": true,
        "screenshot": true
      },
      "expect": [
        {
          "equals": "fr",
          "observation": "language.active"
        },
        {
          "finalTextKey": "gksr.settings.beacon.label",
          "language": "en",
          "observation": "settings.beacon.labelText"
        },
        {
          "finalTextKey": "gksr.settings.beacon.description",
          "language": "en",
          "observation": "settings.beacon.descriptionText"
        }
      ],
      "id": "beacon-settings-label-fallback-en",
      "prerequisites": [
        "游戏语言为简体中文与英语之外的其它语言（例如 fr）。",
        "完整加载模组并进入主菜单 Mods 中的本模组设置页面。"
      ],
      "profileId": "church-beacon",
      "requirements": [
        "GKSA-12"
      ],
      "steps": [
        "把游戏语言设为未覆盖的语言；预期语言非中英；检查 language.active=fr。",
        "进入本模组设置页面记录信标开关名称与说明；预期回退英语；检查两者分别匹配 gksr.settings.beacon.label 与 gksr.settings.beacon.description 且 language=en。"
      ],
      "title": "当前语言缺少译文时信标设置文案回退英语"
    }
  ],
  "schemaVersion": 2
}
