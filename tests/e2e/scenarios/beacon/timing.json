  "kind": "gksr-e2e-scenarios",
  "scenarios": [
    {
      "category": "timing",
      "evidence": {
        "log": true,
        "measurement": true,
        "screenshot": true
      },
      "expect": [
        {
          "equalsEnvironment": "game.sermonWeekday",
          "observation": "save.sermonWeekday"
        },
        {
          "equals": true,
          "observation": "save.isSermonDay"
        },
        {
          "equals": true,
          "observation": "state.readable"
        },
        {
          "equals": true,
          "observation": "done.iconAvailable"
        },
        {
          "equals": true,
          "observation": "done.presentationHealthy"
        },
        {
          "integerGreaterThan": -1,
          "observation": "timing.consumptionFrame"
        },
        {
          "integerGreaterThan": -1,
          "observation": "timing.firstLateUpdateFrameAfterConsumption"
        },
        {
          "integerGreaterThan": -1,
          "observation": "timing.beaconClearedFrame"
        },
        {
          "equalsObservation": "timing.firstLateUpdateFrameAfterConsumption",
          "observation": "timing.beaconClearedFrame"
        },
        {
          "integerBetween": {
            "max": 1,
            "min": 0
          },
          "observation": "timing.framesUntilBeaconCleared"
        },
        {
          "greaterThanObservation": "timing.beaconClearedFrame",
          "observation": "timing.animationEndFrame"
        },
        {
          "numberRange": {
            "maxExclusive": 1
          },
          "observation": "state.sermonReadyValue"
        },
        {
          "equals": false,
          "observation": "beacon.enabled"
        },
        {
          "equals": true,
          "observation": "hud.visible"
        },
        {
          "equals": "gksr.hud.sermonDone",
          "observation": "hud.textKey"
        }
      ],
      "id": "beacon-cleared-first-lateupdate-after-consumption",
      "prerequisites": [
        "两个门槛任务均为 Completed。",
        "布道日当天，原生 sermon_ready >= 1（Ready 状态，信标显示）。",
        "Done 文字与图标资源均健康可用（done.iconAvailable=true 且 done.presentationHealthy=true）。",
        "可记录帧号与动画/奖励结束帧。"
      ],
      "profileId": "church-beacon",
      "requirements": [
        "GKSA-12"
      ],
      "steps": [
        "记录开始布道消耗机会的帧号；预期消耗发生；检查 timing.consumptionFrame >= 0。",
        "记录消耗后首个 LateUpdate 帧号；预期存在且不早于消耗帧；检查 timing.firstLateUpdateFrameAfterConsumption >= timing.consumptionFrame。",
        "记录信标清除帧号；预期与首个 LateUpdate 同帧（允许同帧）；检查 timing.beaconClearedFrame 等于 timing.firstLateUpdateFrameAfterConsumption。",
        "核对 Done 角落文字；预期信标清除后 Done 仍可见；检查 hud.textKey=gksr.hud.sermonDone 且 hud.visible=true。"
      ],
      "title": "开始布道消耗机会后在消耗后第一个 LateUpdate 内清除信标且保留 Done 文字"
    },
