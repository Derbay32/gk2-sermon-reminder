      "id": "beacon-routing-updates-after-transition",
      "prerequisites": [
        "两个门槛任务均为 Completed。",
        "当前为布道日且原生 sermon_ready >= 1。",
        "可在室内外之间移动或使用传送。"
      ],
      "profileId": "church-beacon",
      "requirements": [
        "GKSA-12"
      ],
      "steps": [
        "记录移动前的路由入口；预期入口可读；检查 beacon.routeEntryId 等于 native.routeEntryId。",
        "在室内外之间移动或传送；预期目标更新；检查 beacon.routeUpdatedAfterTransition=true。",
        "核对移动后的有效目标与最终目标；预期与原生一致且仍指向教堂；检查 beacon.effectiveTargetId 等于 native.referenceTargetId 且 beacon.finalTargetId=gd_church_player_pray。"
      ],
      "title": "室内外移动或传送后更新引导目标"
    }
