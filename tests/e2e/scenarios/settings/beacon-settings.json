{
  "kind": "gksr-e2e-scenarios",
  "scenarios": [
    {
      "category": "config",
      "evidence": {
        "log": true,
        "measurement": true,
        "screenshot": true
      },
      "expect": [
        {
          "equals": true,
          "observation": "settings.beacon.defaultEnabled"
        },
        {
          "equals": true,
          "observation": "settings.beacon.enabled"
        },
        {
          "equals": 1,
          "observation": "settings.pageCount"
        },
        {
          "equals": true,
          "observation": "beacon.enabled"
        },
        {
          "equals": true,
          "observation": "beacon.underNativeHud"
        }
      ],
      "id": "beacon-default-enabled-first-run",
      "prerequisites": [
        "同一游戏安装内尚无本模组已保存的设置。",
        "完整加载模组并进入主菜单。"
      ],
      "profileId": "church-beacon",
      "requirements": [
        "GKSA-12"
      ],
      "steps": [
        "进入主菜单 Mods 中的本模组设置页面；预期页面成功打开；检查 settings.pageCount=1。",
        "记录信标开关的默认值；预期首次使用默认开启；检查 settings.beacon.defaultEnabled=true 且 settings.beacon.enabled=true。",
        "载入满足信标资格的存档并观察信标；预期信标显示且位于原生 HUD 下；检查 beacon.enabled=true 与 beacon.underNativeHud=true。"
      ],
      "title": "首次使用且无已保存配置时信标开关默认开启"
    },
    {
      "category": "config",
      "evidence": {
        "log": true,
        "measurement": true,
        "screenshot": true
      },
      "expect": [
        {
          "equals": "keyboard",
          "observation": "input.activeMethod"
        },
        {
          "equals": true,
          "observation": "settings.beacon.toggledByKeyboard"
        },
        {
          "equals": true,
          "observation": "settings.beacon.autoSavedOnToggle"
        },
        {
          "equals": true,
          "observation": "settings.beacon.persistedAfterToggle"
        },
        {
          "equals": true,
          "observation": "settings.beacon.enabled"
        }
      ],
      "id": "beacon-toggle-keyboard-mouse",
      "prerequisites": [
        "已在主菜单进入本模组设置页面。",
        "信标开关当前为开启。"
      ],
      "profileId": "church-beacon",
      "requirements": [
        "GKSA-12"
      ],
      "steps": [
        "使用键鼠把信标开关改为关闭；预期修改成功；检查 settings.beacon.toggledByKeyboard=true 且 input.activeMethod=keyboard。",
        "确认改动后自动保存并重开设置页面；预期读到新值；检查 settings.beacon.autoSavedOnToggle=true 与 settings.beacon.persistedAfterToggle=true。",
        "再次使用键鼠把开关改回开启；预期恢复开启并保存；检查 settings.beacon.enabled=true。"
      ],
      "title": "使用键鼠可修改信标开关并自动保存"
    },
    {
      "category": "config",
      "evidence": {
        "log": true,
        "measurement": true,
