      "id": "icon-load-failure-isolation-retry",
      "prerequisites": [
        "Done 状态且可受控使图标加载失败。",
        "Ready/倒计时的无关可见性可在独立场景验证。"
      ],
      "profileId": "sermon-state",
      "requirements": [
        "GKSA-11"
      ],
      "steps": [
        "注入图标加载失败，观察整个依赖的 Done 呈现（文字与图标）是否被抑制。",
        "确认业务状态仍可读（Done），且无可见 Ready/Done。",
        "解除故障后确认重试成功并恢复可见 Done 与自有 Image。"
      ],
      "title": "图标加载失败时抑制整个依赖的 Done 呈现且可重试恢复"
    },
