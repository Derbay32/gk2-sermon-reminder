      "id": "icon-load-pending-no-stale-state",
      "prerequisites": [
        "Done 状态且图标异步加载可受控处于待定。"
      ],
      "profileId": "sermon-state",
      "requirements": [
        "GKSA-11"
      ],
      "steps": [
        "使图标加载处于待定状态。",
        "确认业务状态仍为可读 Done，且无可见 Ready/Done 呈现（整个依赖呈现被抑制）。",
        "解除阻塞后确认加载完成并显示图标与 Done 文字。"
      ],
      "title": "图标加载待定期间隐藏依赖的 Done 呈现且完成后恢复"
    },
