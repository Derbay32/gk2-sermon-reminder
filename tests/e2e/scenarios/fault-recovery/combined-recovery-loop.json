      ],
      "id": "loop-no-per-frame-log-flood",
      "prerequisites": [
        "必要共享状态或某一显示资源持续重复故障并恢复。",
        "观察区间为有限个连续帧或固定时长。",
        "可读取运行日志并观察原生共享对象与暂停状态。"
      ],
      "profileId": "combined-recovery",
      "requirements": [
        "GKSA-15"
      ],
      "steps": [
        "在有限观察区间内反复触发同类故障与恢复；预期保留首次诊断；检查 log.initialDiagnosticPresent=true。",
        "统计逐帧重复日志；预期无逐帧噪声；检查 log.perFrameRepeatCount=0、log.boundedDuringLoop=true。",
        "确认故障环节标识与调用栈分离；预期满足；检查 log.faultStageIdentified=true、log.stackSeparatedFromUserFacing=true。"
      ],
      "title": "重复故障恢复循环不逐帧刷同一日志且保留初始诊断"
    },
