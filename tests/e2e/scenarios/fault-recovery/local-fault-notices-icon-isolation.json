          "observation": "hud.selectedTextKeyBeforeResolve"
        },
        {
          "equals": false,
          "observation": "hud.visibleBeforeResolve"
        },
        {
          "equals": true,
          "observation": "hud.tmpTextClearedBeforeResolve"
        },
        {
          "equals": true,
