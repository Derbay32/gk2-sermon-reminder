      "id": "notice-copy-en",
      "prerequisites": [
        "游戏语言为英语。",
        "存档加载完成后必要状态读取故障已使状态读取类别消息实际显示。"
      ],
      "profileId": "local-fault-notices",
      "requirements": [
        "GKSA-14"
      ],
      "steps": [
        "在英语下注入必要状态读取故障。预期：使用定稿英语消息。检查：notice.textKey=gksr.status.reminderUnavailable。",
        "读取消息内容。预期：与定稿一致。检查：notice.text 等于 finalText 的 en 完整句。",
        "确认无标题无图标无确认控件。预期：全部满足。检查：notice.titlePresent=false 且 notice.confirmControlPresent=false。"
      ],
      "title": "英语使用定稿状态读取故障消息"
    },
    {
      "category": "localization",
      "evidence": {
        "log": true,
        "measurement": true,
        "screenshot": true
      },
      "expect": [
        {
          "notEquals": "zh_cn",
          "observation": "language.active"
        },
        {
          "notEquals": "en",
          "observation": "language.active"
        },
        {
          "equals": true,
          "observation": "notice.surfaceAvailable"
        },
        {
          "finalTextKey": "gksr.status.reminderUnavailable",
          "language": "en",
          "observation": "notice.text"
        }
      ],
      "id": "notice-fallback-unsupported-language",
      "prerequisites": [
        "游戏语言不是简体中文也不是英语。",
        "存档加载完成后必要状态读取故障已使状态读取类别消息实际显示。"
      ],
      "profileId": "local-fault-notices",
      "requirements": [
        "GKSA-14"
      ],
      "steps": [
        "把游戏语言设为受支持之外的语言。预期：确为非受支持语言。检查：language.active 不等于 zh_cn 与 en。",
        "注入必要状态读取故障。预期：消息回退为英语。检查：notice.text 等于 finalText 的 en 完整句。"
      ],
      "title": "缺少当前语言译文的消息回退为英语"
    },
