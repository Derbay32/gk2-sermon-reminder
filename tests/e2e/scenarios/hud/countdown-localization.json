{
  "kind": "gksr-e2e-scenarios",
  "scenarios": [
    {
      "category": "localization",
      "evidence": {
        "log": false,
        "measurement": false,
        "screenshot": true
      },
      "expect": [
        {
          "dateCheck": {
            "absoluteDay": "save.absoluteDay",
            "countdown": "hud.countdownDays",
            "dayOfWeek": "save.dayOfWeek",
            "language": "en",
            "mode": "multi-day",
            "text": "hud.text",
            "textKey": "hud.textKey"
          }
        },
        {
          "equalsEnvironment": "game.sermonWeekday",
          "observation": "save.sermonWeekday"
        },
        {
          "equals": true,
          "observation": "hud.visible"
        },
        {
          "notEquals": "zh_cn",
          "observation": "language.active"
        },
        {
          "notEquals": "en",
          "observation": "language.active"
        }
      ],
      "id": "language-unsupported-fallback",
      "prerequisites": [
        "解锁条件与教学条件均已满足的当前存档。",
        "游戏语言不是简体中文也不是英语。",
        "相对日期条件：当前为非布道日，且 (T - 当前 + 6) % 6 ∈ 2..5（距离下一布道日大于 1 天）；读取真实布道日星期编号 T（save.sermonWeekday，必须等于环境 game.sermonWeekday，取自 ConstDef.Get(\"day_wrath\").IntValue），不写死 T。"
      ],
      "profileId": "countdown",
      "requirements": [
        "GKSA-10"
      ],
      "steps": [
        "将游戏语言设为受支持之外的语言。",
        "载入该存档并等待加载完成。",
        "记录 save.absoluteDay（绝对日）、save.dayOfWeek（星期编号）与 save.sermonWeekday。",
        "读取左上角时钟下方的倒计时文字与实际选用的文案键。"
      ],
      "title": "游戏语言缺少译文时倒计时回退为英语"
    }
  ],
  "schemaVersion": 2
}
