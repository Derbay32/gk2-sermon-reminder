{
  "kind": "gksr-e2e-scenarios",
  "scenarios": [
    {
      "category": "localization",
      "evidence": {
        "log": true,
        "measurement": true,
        "screenshot": true
      },
      "expect": [
        {
          "equals": "zh_cn",
          "observation": "language.activeBefore"
        },
        {
          "equals": "gksr.hud.sermonReminder",
          "observation": "hud.textKeyBefore"
        },
        {
          "localizedText": {
            "key": "gksr.hud.sermonReminder",
            "language": "zh_cn"
          },
          "observation": "hud.textBefore"
        },
        {
          "equals": "en",
          "observation": "language.activeAfter"
        },
        {
          "equals": "gksr.hud.sermonReminder",
          "observation": "hud.textKeyAfter"
        },
        {
          "localizedText": {
            "key": "gksr.hud.sermonReminder",
            "language": "en"
          },
          "observation": "hud.textAfter"
        },
        {
          "equals": true,
          "observation": "language.hudRefreshedWithoutReload"
        },
        {
          "equals": true,
          "observation": "state.readable"
        },
        {
          "observation": "hud.style.missingRenderedGlyphCount",
          "equals": 0
        },
        {
          "observation": "hud.style.materialAtlasMatchesFont",
          "equals": true
        },
        {
          "observation": "hud.style.unsupportedOutlineAccessCount",
          "equals": 0
        },
        {
          "observation": "hud.style.nativeAssetsUnchanged",
          "equals": true
        }
      ],
      "id": "language-change-refresh",
      "prerequisites": [
        "两个门槛任务均为 Completed。",
        "布道日当天处于 Ready 状态。",
        "可在运行中切换原生语言。"
      ],
      "profileId": "sermon-state",
      "requirements": [
        "GKSA-11",
        "GKSA-29"
      ],
      "steps": [
        "以简体中文观察 Ready 文字。",
        "切换游戏语言为英语。",
        "再次观察 Ready 文字是否在未重载存档的情况下刷新。",
        "记录受检文本对应的实际资源查找；预期命中该场景指定的键与语言；检查 i18n.<文本观察路径>.key、language 与成功读取的 resource。",
        "读取受检文本；预期本地化输出有效；检查非空且没有资源键或未替换的占位符，不比较完整译文。",
        "采集当前 HUD 文本的字形覆盖与渲染字符；预期所有非空白字符可见；检查 missingRenderedGlyphCount=0，不固定译文措辞。",
        "检查实际字体与材质纹理；预期材质使用对应字体图集；检查 materialAtlasMatchesFont=true。",
        "观察 HUD 稳定显示期间的 Unity 日志；预期没有模组引起的不支持描边属性访问；检查 unsupportedOutlineAccessCount=0。",
        "对比显示前后的原生字体、材质与回退列表；预期共享资源未被模组修改；检查 nativeAssetsUnchanged=true。",
        "切回简体中文；预期重新显示完整中文；对每次切换分别留存字形测量、材质测量与截图，汇总失败计数。"
      ],
      "title": "原生语言切换后刷新文字而不重载存档"
    }
  ],
  "schemaVersion": 2
}
