{
  "manifestVersion": 1,
  "kind": "gksa10-e2e-manifest",
  "ticket": "GKSA-10",
  "title": "显示非布道日倒计时：真实游戏 E2E 场景清单",
  "status": "requirements-not-results",
  "notes": [
    "本清单记录待执行的验收要求，不代表任何场景已经执行或通过。",
    "本票只交付非布道日倒计时文字；布道日当天与已布道状态文字由后续三态票交付，本票在该场景只要求停用非布道日倒计时。",
    "验收边界为 CachyOS x86-64 上的 Steam Proton、真实游戏、完整加载模组。",
    "权威成品证据由 tests/e2e/verify.py 校验；校验器不生成证据，也不模拟游戏行为。",
    "布局结论必须附带实测测量值或操作者明确观察记录，并附截图；仅日志不能作为布局证据。",
    "capture 的 environment 与 observations 均使用本清单 observationVocabulary 中的扁平点号键，不嵌套。",
    "requiredEnvironmentPaths 的路径相对 capture.environment 解析。",
    "证据文件路径必须以 capture 文件所在目录为基准的相对路径；禁止绝对路径与越出该目录的路径。",
    "天数按 (sermonWeekday - dayOfWeek + 6) % 6 计算，其中 dayOfWeek 为 day % 6 且余数 0 记为 6，sermonWeekday 取自 ConstDef.Get(\"day_wrath\").IntValue。",
    "hud.style.nativeSource 记录已验证的来源字段标识 HUD.happinessLabel，而非猜测的 GameObject 名称。"
  ],
  "baselineCommit": "7b2a77271bd94bafb9236e2a0076ba4fbb057970",
  "specRefs": [
    "GKSA-1",
    "GKSA-3",
    "GKSA-4",
    "GKSA-9",
    "GKSA-10"
  ],
  "finalTextSource": "Huly document 6ab4dc8908d9ac0dfff99a4e (布道提醒模组：文案清单与人工定稿)",
  "finalText": {
    "gksr.hud.sermonReminder": {
      "zh-CN": "布道日！",
      "en": "Sermon Day!"
    },
    "gksr.hud.sermonCountdown.one": {
      "zh-CN": "明天是布道日！",
      "en": "Sermon Day is Tomorrow!"
    },
    "gksr.hud.sermonCountdown.other": {
      "zh-CN": "距离下一次布道日还有{days}天。",
      "en": "{days} days before the Sermon Day."
    },
    "gksr.hud.sermonDone": {
      "zh-CN": "已完成本周布道！",
      "en": "This week’s sermon is complete!"
    }
  },
  "languageMapping": {
    "catalogLabelToRawGameLanguageId": {
      "zh-CN": "zh_cn",
      "en": "en"
    },
    "knownRawGameLanguageIds": [
      "zh_cn",
      "en"
    ],
    "note": "观察字段 language.active 记录游戏原始语言标识，取自 LazyBearTechnology.LL.GetAvailableLanguages（例如 zh_cn、en、fr）。文案目录标签 zh-CN 仅用于 finalText 与期望的 language 字段，不得用于 language.active。knownRawGameLanguageIds 仅为结构校验示例；其他受测语言的原始标识（如 fr）仍可作为不受支持语言回退场景的取值。"
  },
  "observationVocabulary": {
    "hud.visible": "bool: 角落倒计时文字当前是否可见",
    "hud.text": "string: 角落倒计时文字的完整显示内容",
    "hud.countdownDays": "int: 已显示的整数天数",
    "hud.textKey": "string: 记录的实际选用文案键（gksr.hud.sermonCountdown.one 或 .other）",
    "hud.instanceCount": "int: 模组自有的角落文字显示实例数量",
    "hud.nonSermonCountdownShown": "bool: 布道日当天是否仍显示非布道日倒计时",
    "hud.style.clonedFromNative": "bool: 字体、字号、材质、描边与颜色是否自原生幸福度文字复制",
    "hud.style.nativeSource": "string: 样式复制来源的已验证字段标识 HUD.happinessLabel（表示来源字段，不是未经核实的 GameObject 名称）",
    "hud.style.fontMatchesNative": "bool: 字体一致",
    "hud.style.fontSizeMatchesNative": "bool: 字号一致",
    "hud.style.materialMatchesNative": "bool: 材质一致",
    "hud.style.outlineMatchesNative": "bool: 描边一致",
    "hud.style.colorMatchesNative": "bool: 颜色一致",
    "hud.visibilityInheritsNative": "bool: 可见性与界面层级是否继承原生 HUD",
    "hud.layerEqualsNative": "bool: 界面层级与原生提示层一致",
    "hud.separateMenuHideList": "bool: 是否新增了独立菜单隐藏名单",
    "hud.staleTextFromPreviousSave": "bool: 是否残留上一存档的文字",
    "hud.textFromPreviousSavePresent": "bool: 切档后是否残留旧存档文字",
    "hud.trackedResourcesReleased": "bool: 退出存档时是否释放模组持有的显示资源",
    "layout.anchor": "string: 相对时钟的锚定关系，预期 below_clock",
    "layout.clockOverlap": "bool: 文字是否与时钟重叠",
    "layout.uiScaleFollowsNative": "bool: 是否随原生 UI 缩放",
    "layout.measurement": "object: 实测数值（由测量探针或操作者记录，字段由设施定义）",
    "layout.operatorObservation": "string: 无法数值化时的操作者明确观察记录",
    "save.churchUnlocked": "bool: 教堂开启任务是否 Completed",
    "save.tutorialCompleted": "bool: 首次布道教学任务是否 Completed",
    "save.isSermonDay": "bool: 当前游戏日是否为布道日",
    "save.gameDayNumber": "int: 当前存档的绝对游戏日期编号（EnvironmentData.CurrentDayNumber），正整数",
    "save.afterDayNumber": "int: 跨日后游戏日期编号",
    "save.beforeDayNumber": "int: 跨日前游戏日期编号",
    "save.dayAdvanced": "bool: 操作期间游戏日期是否变化",
    "save.previousSaveTutorialCompleted": "bool: 切换前存档的首次布道教学完成状态",
    "save.tutorialWasCompletedEarlier": "bool: 同一进程先前已载入过教学完成存档",
    "countdown.beforeDays": "int: 日期未变前后连续观察中的前一整数天数",
    "countdown.afterDays": "int: 日期未变前后连续观察中的后一整数天数",
    "language.active": "string: 游戏原始语言标识，取自 LazyBearTechnology.LL.GetAvailableLanguages，例如 zh_cn、en、fr；命名原始 game language，使用 zh_cn 而非文案目录标签 zh-CN",
    "state.readable": "bool: 必要状态是否可可靠读取",
    "fault.staleValueReused": "bool: 故障后是否沿用故障前旧判定",
    "fault.reported": "bool: 是否上报了故障",
    "items.count": "int: 当前背包或基地物品数量",
    "plugin.loaded": "bool: 插件是否在真实 Proton 环境中实际加载",
    "framework.loaded": "bool: GK2 Mod Framework 是否实际加载",
    "save.dayOfWeek": "int: 由原始 day 计算的星期编号；CurrentDayNumber = day % 6，余数 0 记为 6，Build25509347 DAYS_IN_WEEK = 6",
    "save.priorDayOfWeek": "int: 周期边界或跨日前一天的星期编号",
    "save.sermonWeekday": "int: 游戏自身 ConstDef.Get(\"day_wrath\").IntValue 的布道日星期编号",
    "save.daysInWeek": "int: EnvironmentData.DAYS_IN_WEEK 常量值，Build25509347 为 6"
  },
